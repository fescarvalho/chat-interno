# ==========================================
# NOTAS - VARIÁVEIS DE AMBIENTE SUPABASE
# ==========================================

# ------------------------------------------
# FRONTEND (React / Tauri / Vite)
# Prefixo obrigatório: VITE_
# ------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------
# BACKEND / PRISMA (.env na raiz)
# ------------------------------------------
# Conexão principal (Transaction mode via Pooler na porta 6543)
DATABASE_URL=
# Conexão direta (Session mode na porta 5432 - Exclusivo para prisma migrate)
DIRECT_URL="postgresql:

# ------------------------------------------
# CHAVE ADMINISTRATIVA (Backend Opcional)
# ATENÇÃO: NUNCA exponha esta chave no frontend
# ------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
